{
  "protocol": "experiments/pilot_protocol_v1.json",
  "device": "auto",
  "data_root": "data",
  "results_root": "results/pilot",
  "runtime_budget_seconds": 2700,
  "dataset": {
    "name": "FashionMNIST",
    "train_count": 1024,
    "validation_count": 256,
    "subset_seed": 42,
    "transform": "ToTensor"
  },
  "model": {
    "input_dim": 784,
    "width": 128,
    "output_dim": 10,
    "activation": "tanh",
    "initialization": "xavier_uniform"
  },
  "training": {
    "optimizer": "SGD",
    "learning_rate": 0.01,
    "batch_size": 64,
    "max_steps": 100,
    "checkpoints": [0, 100],
    "seeds": [42, 123, 2026]
  },
  "primary_arms": [
    {"arm_id": "primary_d3", "hidden_layers": 3, "xavier_gain": 1.0},
    {"arm_id": "primary_d12", "hidden_layers": 12, "xavier_gain": 1.0}
  ],
  "diagnostic": {
    "enabled": true,
    "arm_id": "diagnostic_d12_xavier_gain_0_5",
    "hidden_layers": 12,
    "xavier_gain": 0.5
  },
  "measurement": {
    "probe_samples": 16,
    "spectrum_probe_samples": 4,
    "spectrum_layers": ["first", "middle", "last"],
    "directional_gain_denominator_threshold": 1e-6
  }
}

